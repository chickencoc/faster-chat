#1337Hero's Overkill Git Ignore!

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/prod_test/

# Monorepo packages
/frontend/node_modules
/server/node_modules
/packages/shared/node_modules

# production
/build
/for_prod/
dist
dist-ssr
*.local
production*
/scripts/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# do not commit any .env files to git
.env
.env.*
!.env.example
!.env.sample

# Database (ignore all .db files everywhere)
*.db
*.db-shm
*.db-wal
*.db.backup*
*.db.bak

# Server runtime data
/server/data/*
!/server/data/.gitkeep

#cache
.eslintcache

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/typescript

#misc
/_backup
/.idea
/docs
/specs

# Editor directories and files
/.claude/settings.local.json
._*
.vscode/*
!.vscode/extensions.json
.DS_Store
.Spotlight-V100
.Trashes
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
