# Set to production when serving the built frontend behind HTTPS
NODE_ENV=development

# Server port for Hono API (Bun default: 3001, Docker default: 8787)
PORT=8787

# Bind to 127.0.0.1 when Apache runs on the same host
HOST=0.0.0.0

# Security / encryption
# REQUIRED: replace the empty value before starting the server
# Generate with: bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=

# Set to true behind a trusted proxy such as Apache or Nginx
TRUST_PROXY=false

# Database
DATABASE_URL=sqlite://./data/chat.db

# Public browser origin for production CORS, without a path or trailing slash
# Apache example: https://domain (not http://127.0.0.1:18700)
APP_URL=http://localhost:3000

# Provider API keys are configured in Admin > Providers and encrypted in SQLite.
# OPENAI_API_KEY in this file alone does not register an OpenAI provider.
